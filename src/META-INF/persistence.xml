<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">

    <persistence-unit name="teatroPU"
                      transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <class>br.com.projetoteatro.model.Pessoa</class>
        <class>br.com.projetoteatro.model.Administrador</class>
        <class>br.com.projetoteatro.model.Assento</class>
        <class>br.com.projetoteatro.model.Cliente</class>
        <class>br.com.projetoteatro.model.Contratante</class>
        <class>br.com.projetoteatro.model.Contrato</class>
        <class>br.com.projetoteatro.model.Ingresso</class>
        <class>br.com.projetoteatro.model.Peca</class>
        <class>br.com.projetoteatro.model.PropostaAluguel</class>
        <class>br.com.projetoteatro.model.RegraAluguel</class>
        <class>br.com.projetoteatro.model.Sessao</class>
        <class>br.com.projetoteatro.model.Setor</class>
        <class>br.com.projetoteatro.model.Usuario</class>

        <properties>

            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:./bancoteatro;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE"/>

            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.H2Dialect"/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <property name="hibernate.show_sql"
                      value="true"/>

            <property name="hibernate.format_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>